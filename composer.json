{
  "name": "thewebsolver/luhn-algorithm",
  "description": "PHP library to validate digits such as Credit Card Number, IMEI number, etc. with Luhn Algorithm",
  "type": "library",
  "keywords": [
    "luhn",
    "luhn-algorithm",
    "validator",
    "validation",
    "payment-card",
    "credit-card",
    "IMEI",
    "bank-card"
  ],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Shesh Ghimire",
      "email": "sheshgh@outlook.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "TheWebSolver\\Codegarage\\Validator\\": "Src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "thewebsolver\\Codegarage\\Test\\": "Tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
